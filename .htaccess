# ==============================================================
# Shyam Packers & Movers — Hostinger Optimized .htaccess
# (Caching managed by Hostinger / LiteSpeed Web Server)
# ==============================================================

# Disable directory listing
Options -Indexes

# ---------------------------------------------------------------
# 1. REWRITE ENGINE & HTTPS REDIRECT
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force www to non-www (canonical domain)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Clean URLs: Allow visiting /services instead of /services.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# ---------------------------------------------------------------
# 2. SECURITY HEADERS
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent clickjacking / embedding in unauthorized iframes
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Referrer policy for modern privacy & tracking security
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict unauthorized browser features
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Cross-Origin font access (fixes font loading if CDN/subdomain is used)
  <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|js)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------
# 3. PROTECT SENSITIVE & HIDDEN FILES
# ---------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "\.(env|log|sh|bak|sql|conf|ini|lock|git|yml|yaml)$">
  Require all denied
</FilesMatch>

# Allow web manifest
<FilesMatch "^(site\.webmanifest|manifest\.json)$">
  Require all granted
</FilesMatch>

# ---------------------------------------------------------------
# 4. CUSTOM ERROR PAGES
# ---------------------------------------------------------------
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html
